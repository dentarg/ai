#!/bin/sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$SCRIPT_DIR
# shellcheck source=tools/build-common.sh
. "${REPO_DIR}/tools/build-common.sh"

VM_CPUS=${AI_VM_CPUS:-4}
VM_MEMORY=${AI_VM_MEMORY:-8}
VM_DISK=${AI_VM_DISK:-100}
VM_BUILD_TIMEOUT=${AI_VM_BUILD_TIMEOUT:-60m}
ASSET_MANIFEST=${REPO_DIR}/lima/assets/manifest.txt
FORCE=0
GPU=0
UPDATE_CLAUDE=0
UPDATE_CODEX=0
UPDATE_PLUGINS=0

BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ai-vm-build.XXXXXX")
cleanup() {
  rm -rf "$BUILD_DIR"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

usage () {
  echo "Usage: ./build_vm [--force] [--gpu] [--update-claude] [--update-codex] [--update-plugins]" >&2
  echo "       ./build_vm [--force] [--gpu] --update-agents" >&2
  exit "${1:-1}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --gpu) GPU=1 ;;
    --update-claude) UPDATE_CLAUDE=1 ;;
    --update-codex) UPDATE_CODEX=1 ;;
    --update-plugins) UPDATE_PLUGINS=1 ;;
    --update-agents) UPDATE_CLAUDE=1; UPDATE_CODEX=1; UPDATE_PLUGINS=1 ;;
    -h|--help) usage 0 ;;
    *) echo "at=fatal msg=\"unknown option\" option=\"$1\"" >&2; usage ;;
  esac
  shift
done

if [ "$GPU" -eq 1 ]; then
  BASE_NAME=${AI_VM_BASE:-ai-base-gpu}
else
  BASE_NAME=${AI_VM_BASE:-ai-base}
fi

command -v limactl >/dev/null 2>&1 || {
  echo 'at=fatal msg="limactl is required; install Lima first"' >&2
  exit 1
}
if [ "$GPU" -eq 1 ]; then
  command -v jq >/dev/null 2>&1 || {
    echo 'at=fatal msg="jq is required to build the GPU VM"' >&2
    exit 1
  }
  command -v krunkit >/dev/null 2>&1 || {
    echo 'at=fatal msg="krunkit is required to build the GPU VM"' >&2
    exit 1
  }
  if ! limactl info | jq -e '.vmTypesEx.krunkit.location // empty' >/dev/null; then
    echo 'at=fatal msg="Lima krunkit driver is not available"' >&2
    exit 1
  fi
fi

[ "$UPDATE_CLAUDE" -eq 1 ] && update_claude_version
[ "$UPDATE_CODEX" -eq 1 ] && update_codex_version
[ "$UPDATE_PLUGINS" -eq 1 ] && \
  update_plugin_manifest "$REPO_DIR/versions/codex-plugins"

ASSET_DIR=${BUILD_DIR}/assets
INSTALLERS_TAR=${BUILD_DIR}/ai-build-installers.tar.gz
PROJECT_TAR=${BUILD_DIR}/ai-build-project.tar.gz
INSTALLERS_ARCHIVE=${INSTALLERS_TAR}.b64
PROJECT_ARCHIVE=${PROJECT_TAR}.b64
VM_TEMPLATE=${BUILD_DIR}/ai.lima.yaml
mkdir -p "${ASSET_DIR}/installers" "${ASSET_DIR}/project"
while read -r destination source archive; do
  case "$destination" in
    ''|'#'*) continue ;;
  esac
  cp "${REPO_DIR}/${source}" "${ASSET_DIR}/${archive}/${destination}"
done < "$ASSET_MANIFEST"
# macOS tar otherwise records com.apple.* extended attributes that GNU tar in
# the guest reports as unknown LIBARCHIVE headers.
COPYFILE_DISABLE=1 tar -czf "$INSTALLERS_TAR" -C "${ASSET_DIR}/installers" .
COPYFILE_DISABLE=1 tar -czf "$PROJECT_TAR" -C "${ASSET_DIR}/project" .
base64 < "$INSTALLERS_TAR" > "$INSTALLERS_ARCHIVE"
base64 < "$PROJECT_TAR" > "$PROJECT_ARCHIVE"
for archive in "$INSTALLERS_ARCHIVE" "$PROJECT_ARCHIVE"; do
  if [ "$(wc -c < "$archive")" -gt 60000 ]; then
    echo "at=fatal msg=\"VM asset archive exceeds Lima's safe embedding size\" archive=$archive" >&2
    exit 1
  fi
done
sed \
  -e "s|@AI_BUILD_INSTALLERS_ARCHIVE@|${INSTALLERS_ARCHIVE}|" \
  -e "s|@AI_BUILD_PROJECT_ARCHIVE@|${PROJECT_ARCHIVE}|" \
  "${REPO_DIR}/ai.lima.yaml" > "$VM_TEMPLATE"

exists=0
limactl list --format '{{.Name}}' 2>/dev/null | grep -Fx "$BASE_NAME" >/dev/null 2>&1 && exists=1
if [ "$exists" -eq 1 ] && [ "$FORCE" -ne 1 ]; then
  echo "at=fatal msg=\"base VM already exists; use --force to rebuild\" vm=$BASE_NAME" >&2
  exit 1
fi

if [ "$exists" -eq 1 ]; then
  limactl unprotect "$BASE_NAME" >/dev/null 2>&1 || true
  limactl delete --force "$BASE_NAME"
fi

limactl validate "$VM_TEMPLATE"
set -- create --tty=false
[ "$GPU" -eq 1 ] && set -- "$@" --vm-type krunkit
set -- "$@" \
  --name "$BASE_NAME" \
  --cpus "$VM_CPUS" \
  --memory "$VM_MEMORY" \
  --disk "$VM_DISK" \
  "$VM_TEMPLATE"
limactl "$@"
limactl start --progress --timeout "$VM_BUILD_TIMEOUT" "$BASE_NAME"
limactl shell "$BASE_NAME" sudo env AI_VM_GPU="$GPU" \
  HOME=/workspace BASH_ENV=/workspace/.bash_profile \
  bash -lc '
    if ! test -f /var/lib/ai-base-provisioned; then
      echo "at=fatal msg=\"VM provisioning did not complete; inspect the cloud-init output above\"" >&2
      exit 1
    fi
    docker info >/dev/null
    docker buildx version
    docker compose version
    command -v codex
    command -v claude
    command -v tailcat
    test -s /workspace/.bashrc
    test -s /usr/local/bin/cx
    test -s /usr/local/bin/x
    grep -F "alias x=exit" /workspace/.bashrc >/dev/null
    if [ "$AI_VM_GPU" -eq 1 ]; then
      test -c /dev/dri/renderD128
      command -v llama-cli
      command -v llama-server
      llama-cli --list-devices | grep -F "Vulkan0:"
    fi
    # The external krunkit driver stops by terminating its process. Flush late
    # provisioning writes before Lima stops the base and clones its raw disk.
    sync
  '
limactl stop "$BASE_NAME"
# Reopen the disk once before protecting it. This catches krunkit shutdowns
# that retained file metadata but lost recently written file contents.
limactl start --timeout "$VM_BUILD_TIMEOUT" "$BASE_NAME"
limactl shell "$BASE_NAME" sudo env AI_VM_GPU="$GPU" bash -lc '
  test -s /workspace/.bashrc
  test -s /usr/local/bin/cx
  test -s /usr/local/bin/x
  grep -F "alias x=exit" /workspace/.bashrc >/dev/null
  swapon --show=NAME --noheadings | grep -Fx /dev/zram0 >/dev/null
  systemctl is-enabled --quiet docker.socket
  ! systemctl is-enabled --quiet docker.service
  if [ "$AI_VM_GPU" -eq 1 ]; then
    docker image inspect ai-llama.cpp >/dev/null
    test -L /usr/local/bin/llama-cli
    test -L /usr/local/bin/llama-server
  fi
  sync
'
limactl stop "$BASE_NAME"
limactl protect "$BASE_NAME"
echo "at=info msg=\"base VM ready\" vm=$BASE_NAME"
