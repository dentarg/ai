#compdef ai bin/ai ./bin/ai

if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  compinit
fi

_ai_profiles() {
  local command=$words[1]
  local -a profiles
  profiles=("${(@f)$("$command" profile list 2>/dev/null | awk 'NR > 1 {print $1}')}" )
  _describe profile profiles
}

_ai_models() {
  local command=$words[1]
  local agent=$words[5]
  local -a models
  models=("${(@f)$("$command" models list "$agent" 2>/dev/null)}")
  _describe model models
}

_ai_browser_profile_options() {
  local path
  print -r -- --host-browser=default
  for path in "${AI_DIR:-${HOME}/ai}/host-browser/profiles"/*(N/); do
    print -r -- "--host-browser=${path:t}"
  done
}

_ai_github_profile_options() {
  local base=${XDG_CONFIG_HOME:-}
  case "$base" in /*) ;; *) base="$HOME/.config" ;; esac
  jq -r '.profiles | keys[] | select(test("^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")) | "--github=" + .' \
    "$base/ai/github-bridge.json" 2>/dev/null || true
}

_ai_commands_options() {
  local -a commands options values
  commands=(profile models session completion c claude cx codex)
  options=(
    --resume --ports --udp-ports --vm --keep-vm --gpu --nested-virt
    --cpus --memory --github --1password --host-browser --remote --fast --help
    "${(@f)$(_ai_browser_profile_options)}"
    "${(@f)$(_ai_github_profile_options)}"
  )
  values=("${commands[@]}" "${options[@]}")
  compadd -V ai-arguments -- "${values[@]}"
}

_ai_profiles_options() {
  local command=$words[1]
  local -a profiles options values
  profiles=("${(@f)$("$command" profile list 2>/dev/null | awk 'NR > 1 {print $1}')}" )
  options=(
    --resume --ports --udp-ports --vm --keep-vm --gpu --nested-virt
    --cpus --memory --github --1password --host-browser --help
    "${(@f)$(_ai_browser_profile_options)}"
    "${(@f)$(_ai_github_profile_options)}"
  )
  case "$words[2]" in c|claude) options+=(--remote --fast) ;; esac
  values=("${profiles[@]}" "${options[@]}")
  compadd -V ai-arguments -- "${values[@]}"
}

_ai() {
  local first=${words[2]:-}
  local action=${words[3]:-}

  case "$CURRENT" in
    2)
      _ai_commands_options
      ;;
    3)
      case "$first" in
        profile) _values command list create remove set-model login --help ;;
        models) _values command list refresh --help ;;
        session) _values command start attach list stop logs replay ports invite invitations revoke join --help ;;
        completion) _values shell bash zsh ;;
        c|claude|cx|codex) _ai_profiles_options ;;
      esac
      ;;
    4)
      case "$first:$action" in
        profile:remove|profile:set-model|profile:login) _ai_profiles ;;
        models:list) _values agent codex claude ;;
      esac
      ;;
    5)
      [[ "$first" == profile && \
        ( "$action" == set-model || "$action" == login ) ]] && \
        _values agent codex claude
      ;;
    6)
      [[ "$first" == profile && "$action" == set-model ]] && _ai_models
      ;;
  esac
}

compdef _ai ai bin/ai ./bin/ai
