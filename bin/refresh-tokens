#!/bin/bash

set -euo pipefail

CREDENTIALS_DIR="${CREDENTIALS_DIR:-/settings}"
CHECK_INTERVAL="${CHECK_INTERVAL:-300}"
REFRESH_BEFORE="${REFRESH_BEFORE:-3600}"

CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
TOKEN_URL="https://platform.claude.com/v1/oauth/token"

log() {
  local level="$1"; shift
  echo "at=$level ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

now_ms() {
  echo "$(( $(date +%s) * 1000 ))"
}

refresh_file() {
  local file="$1"
  local now
  now=$(now_ms)

  local oauth_key
  oauth_key=$(jq -r 'keys[] | select(test("oauth"; "i"))' "$file" 2>/dev/null | head -1)
  if [[ -z "$oauth_key" ]]; then
    return 0
  fi

  local expires_at refresh_tok
  expires_at=$(jq -r ".[\"${oauth_key}\"].expiresAt" "$file")
  refresh_tok=$(jq -r ".[\"${oauth_key}\"].refreshToken" "$file")

  if [[ -z "$refresh_tok" || "$refresh_tok" == "null" ]]; then
    log warn "msg=\"no refresh token\" file=$(basename "$file")"
    return 1
  fi

  local threshold_ms=$(( REFRESH_BEFORE * 1000 ))
  local remaining_ms=$(( expires_at - now ))
  local remaining_secs=$(( remaining_ms / 1000 ))

  if (( remaining_ms > threshold_ms )); then
    log info "msg=\"token valid\" file=$(basename "$file") remaining_secs=$remaining_secs"
    return 0
  fi

  log info "msg=\"refreshing\" file=$(basename "$file") remaining_secs=$remaining_secs"

  local scopes
  scopes=$(jq -r ".[\"${oauth_key}\"].scopes | join(\" \")" "$file" 2>/dev/null || echo "")

  local response
  if ! response=$(curl -sf -X POST "$TOKEN_URL" \
    -H "Content-Type: application/x-www-form-urlencoded" \
    -H "Accept: application/json" \
    -d "grant_type=refresh_token" \
    -d "refresh_token=${refresh_tok}" \
    -d "client_id=${CLIENT_ID}" \
    ${scopes:+-d "scope=${scopes}"}); then
    log error "msg=\"refresh request failed\" file=$(basename "$file")"
    return 1
  fi

  local new_access new_expires_in new_refresh
  new_access=$(echo "$response" | jq -r '.access_token')
  new_expires_in=$(echo "$response" | jq -r '.expires_in')
  new_refresh=$(echo "$response" | jq -r '.refresh_token // empty')

  if [[ -z "$new_access" || "$new_access" == "null" ]]; then
    log error "msg=\"no access token in response\" file=$(basename "$file")"
    return 1
  fi

  local new_expires_at
  new_expires_at=$(( $(now_ms) + new_expires_in * 1000 ))

  local tmp="${file}.tmp"
  jq --arg at "$new_access" \
     --arg rt "${new_refresh:-$refresh_tok}" \
     --argjson ea "$new_expires_at" \
     ".[\"${oauth_key}\"].accessToken = \$at | .[\"${oauth_key}\"].refreshToken = \$rt | .[\"${oauth_key}\"].expiresAt = \$ea" \
     "$file" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"

  log info "msg=\"refreshed\" file=$(basename "$file") expires_at=$new_expires_at"
}

run() {
  local found=0
  for file in "${CREDENTIALS_DIR}"/.credentials*.json; do
    [[ -f "$file" ]] || continue
    found=1
    refresh_file "$file" || true
  done
  if [[ "$found" -eq 0 ]]; then
    log warn "msg=\"no credential files found\" dir=$CREDENTIALS_DIR"
  fi
}

usage() {
  echo "Usage: $(basename "$0") [--once]"
  echo ""
  echo "Keeps Claude Code OAuth tokens fresh by refreshing before expiry."
  echo ""
  echo "Options:"
  echo "  --once    Refresh once and exit (no daemon loop)"
  echo ""
  echo "Environment:"
  echo "  CREDENTIALS_DIR   Directory with .credentials*.json files (default: /settings)"
  echo "  CHECK_INTERVAL    Seconds between checks (default: 300)"
  echo "  REFRESH_BEFORE    Seconds before expiry to refresh (default: 3600)"
}

main() {
  case "${1:-}" in
    --once)
      run
      return
      ;;
    --help|-h)
      usage
      return
      ;;
  esac

  log info "msg=\"starting\" dir=$CREDENTIALS_DIR interval=${CHECK_INTERVAL}s threshold=${REFRESH_BEFORE}s"

  while true; do
    run
    sleep "$CHECK_INTERVAL"
  done
}

main "$@"
