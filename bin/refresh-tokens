#!/usr/bin/env -S BASH_ENV= bash

set -euo pipefail

CREDENTIALS_DIR="${CREDENTIALS_DIR:-${HOME:?HOME must be set}/.claude}"
CHECK_INTERVAL="${CHECK_INTERVAL:-300}"
REFRESH_BEFORE="${REFRESH_BEFORE:-3600}"
HISTORY_DIR="${HISTORY_DIR:-${HOME}/ai/history}"
HISTORY_DAYS="${HISTORY_DAYS:-2}"

CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
TOKEN_URL="https://platform.claude.com/v1/oauth/token"
AUTHORIZE_URL="https://claude.ai/oauth/authorize"
REDIRECT_URI="https://platform.claude.com/oauth/code/callback"
SCOPES="org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload"
USER_AGENT="axios/1.13.6"

log() {
  local level="$1"; shift
  echo "at=$level ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

now_ms() {
  echo "$(( $(date +%s) * 1000 ))"
}

format_expiry() {
  local ms=$1
  local secs=$((ms / 1000))
  date -u -r "$secs" +"%Y-%m-%d %H:%M:%S UTC" 2>/dev/null \
    || date -u -d "@$secs" +"%Y-%m-%d %H:%M:%S UTC"
}

urlencode() {
  jq -rn --arg v "$1" '$v | @uri'
}

refresh_file() {
  local file="$1"
  local now
  now=$(now_ms)

  local oauth_key
  oauth_key=$(jq -r 'keys[] | select(test("oauth"; "i"))' "$file" 2>/dev/null | head -1)
  if [[ -z "$oauth_key" ]]; then
    return 0
  fi

  local expires_at refresh_tok
  expires_at=$(jq -r ".[\"${oauth_key}\"].expiresAt" "$file")
  refresh_tok=$(jq -r ".[\"${oauth_key}\"].refreshToken" "$file")

  if [[ -z "$refresh_tok" || "$refresh_tok" == "null" ]]; then
    log warn "msg=\"no refresh token\" file=$(basename "$file")"
    return 1
  fi

  local threshold_ms=$(( REFRESH_BEFORE * 1000 ))
  local remaining_ms=$(( expires_at - now ))
  local remaining_secs=$(( remaining_ms / 1000 ))
  local expires_human
  expires_human=$(format_expiry "$expires_at")

  if (( remaining_ms > threshold_ms )); then
    log info "msg=\"token valid\" file=$(basename "$file") remaining_secs=$remaining_secs expires=\"$expires_human\""
    return 0
  fi

  log info "msg=\"refreshing\" file=$(basename "$file") remaining_secs=$remaining_secs expires=\"$expires_human\""

  local scopes
  scopes=$(jq -r ".[\"${oauth_key}\"].scopes | join(\" \")" "$file" 2>/dev/null || echo "")

  local body
  body=$(jq -n \
    --arg rt "$refresh_tok" \
    --arg scope "$scopes" \
    '{grant_type: "refresh_token", refresh_token: $rt, client_id: "'"$CLIENT_ID"'", scope: $scope}')

  local response http_status
  response=$(curl -s --compressed -w '\n%{http_code}' -X POST "$TOKEN_URL" \
    -H "Accept: application/json, text/plain, */*" \
    -H "Content-Type: application/json" \
    -H "User-Agent: $USER_AGENT" \
    -d "$body") || true
  http_status="${response##*$'\n'}"
  response="${response%$'\n'*}"

  if [[ -z "$response" ]]; then
    log error "msg=\"refresh request failed (no response)\" file=$(basename "$file") http_status=${http_status:-0}"
    return 1
  fi

  if [[ "$response" == *"rate_limit_error"* ]]; then
    log warn "msg=\"rate limited, will retry next cycle\" file=$(basename "$file") http_status=$http_status"
    return 1
  fi

  if [[ "$response" != *"access_token"* ]]; then
    local err body_single
    err=$(echo "$response" | jq -r '.error.message // .message // .error_description // (.error | strings) // (.error | tojson) // empty' 2>/dev/null) || true
    body_single=$(echo "$response" | tr -d '\n' | tr -d '\r' | cut -c1-500)
    log error "msg=\"refresh failed\" file=$(basename "$file") http_status=$http_status error=\"${err:-unknown}\" body=\"${body_single//\"/\\\"}\""
    return 1
  fi

  local new_access new_expires_in new_refresh
  new_access=$(echo "$response" | jq -r '.access_token')
  new_expires_in=$(echo "$response" | jq -r '.expires_in')
  new_refresh=$(echo "$response" | jq -r '.refresh_token // empty')

  if [[ -z "$new_access" || "$new_access" == "null" ]]; then
    log error "msg=\"no access token in response\" file=$(basename "$file")"
    return 1
  fi

  local new_expires_at
  new_expires_at=$(( $(now_ms) + new_expires_in * 1000 ))
  local new_expires_human
  new_expires_human=$(format_expiry "$new_expires_at")

  local tmp="${file}.tmp"
  jq --arg at "$new_access" \
     --arg rt "${new_refresh:-$refresh_tok}" \
     --argjson ea "$new_expires_at" \
     ".[\"${oauth_key}\"].accessToken = \$at | .[\"${oauth_key}\"].refreshToken = \$rt | .[\"${oauth_key}\"].expiresAt = \$ea" \
     "$file" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"

  log info "msg=\"refreshed\" file=$(basename "$file") expires=\"$new_expires_human\""
}

run() {
  if [[ ! -d "$CREDENTIALS_DIR" ]]; then
    log info "msg=\"credentials dir not found, skipping\" dir=$CREDENTIALS_DIR"
    return 0
  fi

  local found=0
  for file in "${CREDENTIALS_DIR}"/.credentials*.json; do
    [[ -f "$file" ]] || continue
    found=1
    refresh_file "$file" || true
  done
  if [[ "$found" -eq 0 ]]; then
    log info "msg=\"no credential files found\" dir=$CREDENTIALS_DIR"
  fi
}

active_history_credentials() {
  local profile_filter="${1:-}"

  case "$HISTORY_DAYS" in
    ''|*[!0-9]*|0)
      log error "msg=\"invalid history search window\" days=$HISTORY_DAYS"
      return 1
      ;;
  esac

  [[ -d "$HISTORY_DIR" ]] || return 0

  local now file profile expires_at
  now=$(now_ms)

  while IFS= read -r -d '' file; do
    [[ -f "${file%/*}/.profile" ]] || continue
    IFS= read -r profile < "${file%/*}/.profile" || true
    [[ -n "$profile" ]] || continue
    [[ -z "$profile_filter" || "$profile" == "$profile_filter" ]] || continue

    expires_at=$(jq -r \
      '.claudeAiOauth.expiresAt | numbers // empty' "$file" 2>/dev/null) || continue
    [[ "$expires_at" =~ ^[0-9]+$ ]] || continue
    (( expires_at > now )) || continue

    printf '%s\t%s\t%s\n' "$expires_at" "$profile" "$file"
  done < <(
    find "$HISTORY_DIR" \
      -mindepth 4 \
      -maxdepth 4 \
      -type f \
      -path '*_claude/.credentials.json' \
      -mtime "-${HISTORY_DAYS}" \
      -print0 2>/dev/null
  ) | sort -t $'\t' -k1,1nr -k3,3r
}

list_active_history_credentials() {
  local profile_filter="${1:-}"
  local expires_at profile file

  printf 'PROFILE\tEXPIRES\tPATH\n'
  while IFS=$'\t' read -r expires_at profile file; do
    [[ -n "$file" ]] || continue
    printf '%s\t%s\t%s\n' \
      "$profile" "$(format_expiry "$expires_at")" "$file"
  done < <(active_history_credentials "$profile_filter")
}

find_active_history_credentials() {
  local profile=$1
  local expires_at file

  while IFS=$'\t' read -r expires_at _ file; do
    [[ -n "$file" ]] || continue
    printf '%s\n' "$file"
    return 0
  done < <(active_history_credentials "$profile")

  return 1
}

copy_active_history_credentials() {
  local profile=$1
  local destination=$2
  local source destination_dir tmp

  if ! source=$(find_active_history_credentials "$profile"); then
    log error "msg=\"no active credentials found\" profile=\"$profile\" dir=\"$HISTORY_DIR\""
    return 1
  fi

  destination_dir=$(dirname "$destination")
  if [[ ! -d "$destination_dir" ]]; then
    log error "msg=\"destination directory not found\" dir=\"$destination_dir\""
    return 1
  fi

  if ! tmp=$(mktemp "${destination}.tmp.XXXXXX"); then
    return 1
  fi
  if ! (umask 077 && cp "$source" "$tmp" && chmod 600 "$tmp"); then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$destination"
  log info "msg=\"copied active credentials\" profile=\"$profile\" source=\"$source\" destination=\"$destination\""
}

login() {
  local profile="${1:-}"
  local cred_file

  if [[ -n "$profile" ]]; then
    cred_file="${CREDENTIALS_DIR}/.credentials.${profile}.json"
  else
    cred_file="${CREDENTIALS_DIR}/.credentials.json"
  fi

  local code_verifier code_challenge state
  code_verifier=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
  code_challenge=$(printf '%s' "$code_verifier" | openssl dgst -sha256 -binary | openssl base64 | tr '+/' '-_' | tr -d '=')
  state=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')

  # Match Claude Code's URLSearchParams encoding exactly
  local scope_plus="${SCOPES// /+}"
  scope_plus="${scope_plus//:/%3A}"
  local auth_url="${AUTHORIZE_URL}"
  auth_url+="?code=true"
  auth_url+="&client_id=${CLIENT_ID}"
  auth_url+="&response_type=code"
  auth_url+="&redirect_uri=$(urlencode "$REDIRECT_URI")"
  auth_url+="&scope=${scope_plus}"
  auth_url+="&code_challenge=${code_challenge}"
  auth_url+="&code_challenge_method=S256"
  auth_url+="&state=${state}"

  echo ""
  echo "Open this URL in your browser to sign in:"
  echo ""
  echo "  ${auth_url}"
  echo ""
  echo "After authorizing, paste the code or the full callback URL:"
  echo ""

  local input
  read -r -p "Code: " input

  local code
  if [[ "$input" =~ code=([^&#]+) ]]; then
    code="${BASH_REMATCH[1]}"
  else
    code="$input"
  fi

  # Strip URL fragment (#state) if present
  code="${code%%#*}"

  if [[ -z "$code" ]]; then
    echo "Error: no code provided"
    return 1
  fi

  local response="" attempt
  local max_attempts=5 wait_secs=60
  local exchanged=false

  for attempt in $(seq 1 $max_attempts); do
    local body
    body=$(jq -n \
      --arg code "$code" \
      --arg verifier "$code_verifier" \
      --arg state "$state" \
      '{grant_type: "authorization_code", code: $code, redirect_uri: "'"$REDIRECT_URI"'", client_id: "'"$CLIENT_ID"'", code_verifier: $verifier, state: $state}')

    response=$(curl -s --compressed -X POST "$TOKEN_URL" \
      -H "Accept: application/json, text/plain, */*" \
      -H "Content-Type: application/json" \
      -H "User-Agent: $USER_AGENT" \
      -d "$body") || true

    if [[ -z "$response" ]]; then
      echo "Error: token exchange request failed (no response)"
      return 1
    fi

    if [[ "$response" == *"rate_limit_error"* ]]; then
      echo "Rate limited, retrying in ${wait_secs}s... (attempt $attempt/$max_attempts)"
      sleep "$wait_secs"
      wait_secs=$(( wait_secs * 2 ))
      continue
    fi

    exchanged=true
    break
  done

  if [[ "$exchanged" != "true" ]]; then
    echo "Error: still rate limited after $max_attempts attempts"
    return 1
  fi

  if [[ "$response" != *"access_token"* ]]; then
    local msg
    msg=$(echo "$response" | jq -r '.error.message // .message // .error_description // empty' 2>/dev/null) || true
    echo "Error: ${msg:-$response}"
    return 1
  fi

  local access_token refresh_token expires_in
  access_token=$(echo "$response" | jq -r '.access_token')
  refresh_token=$(echo "$response" | jq -r '.refresh_token')
  expires_in=$(echo "$response" | jq -r '.expires_in')

  if [[ -z "$access_token" || "$access_token" == "null" ]]; then
    echo "Error: no access token in response"
    echo "$response" | jq . 2>/dev/null || echo "$response"
    return 1
  fi

  local expires_at
  expires_at=$(( $(now_ms) + expires_in * 1000 ))

  local scope_response scopes_json
  scope_response=$(echo "$response" | jq -r '.scope // empty')
  if [[ -n "$scope_response" ]]; then
    scopes_json=$(echo "$scope_response" | tr ' ' '\n' | jq -R . | jq -s .)
  else
    scopes_json=$(echo "$SCOPES" | tr ' ' '\n' | jq -R . | jq -s .)
  fi

  jq -n \
    --arg at "$access_token" \
    --arg rt "$refresh_token" \
    --argjson ea "$expires_at" \
    --argjson sc "$scopes_json" \
    '{"claudeAiOauth": {"accessToken": $at, "refreshToken": $rt, "expiresAt": $ea, "scopes": $sc}}' \
    > "$cred_file"
  chmod 600 "$cred_file"

  local expires_human
  expires_human=$(format_expiry "$expires_at")
  echo ""
  echo "Login successful! Credentials saved to $(basename "$cred_file")"
  echo "Token expires at ${expires_human}"
}

usage() {
  echo "Usage: $(basename "$0") <command> [options]"
  echo ""
  echo "Keeps Claude Code OAuth tokens fresh by refreshing before expiry."
  echo ""
  echo "Commands:"
  echo "  --login [profile]   Sign in with OAuth and save credentials"
  echo "  --once              Refresh all tokens once and exit"
  echo "  --daemon            Run as a daemon, refreshing tokens periodically"
  echo "  --list-active [profile]"
  echo "                      List active credentials in Claude session history"
  echo "  --find-active <profile>"
  echo "                      Print the freshest active credentials path"
  echo "  --copy-active <profile> <path>"
  echo "                      Copy the freshest active credentials to path"
  echo "  --help, -h          Show this help"
  echo ""
  echo "Environment:"
  echo "  CREDENTIALS_DIR   Directory with .credentials*.json files (default: ~/.claude)"
  echo "  CHECK_INTERVAL    Seconds between checks in daemon mode (default: 300)"
  echo "  REFRESH_BEFORE    Seconds before expiry to refresh (default: 3600)"
  echo "  HISTORY_DIR       Claude session history (default: ~/ai/history)"
  echo "  HISTORY_DAYS      Recent days of history to search (default: 2)"
}

main() {
  case "${1:-}" in
    --login)
      login "${2:-}"
      ;;
    --once)
      run
      ;;
    --daemon)
      log info "msg=\"starting\" dir=$CREDENTIALS_DIR interval=${CHECK_INTERVAL}s threshold=${REFRESH_BEFORE}s"
      while true; do
        run
        sleep "$CHECK_INTERVAL"
      done
      ;;
    --list-active)
      list_active_history_credentials "${2:-}"
      ;;
    --find-active)
      [[ -n "${2:-}" ]] || { usage >&2; return 1; }
      find_active_history_credentials "$2"
      ;;
    --copy-active)
      [[ -n "${2:-}" && -n "${3:-}" ]] || { usage >&2; return 1; }
      copy_active_history_credentials "$2" "$3"
      ;;
    --help|-h)
      usage
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
