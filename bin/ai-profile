#!/bin/sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AI_DIR=${AI_DIR:-"${HOME}/ai"}
SETTINGS_DIR=${SETTINGS_DIR:-"${AI_DIR}/settings"}

usage() {
  cat <<EOF
Usage: ai profile <command> [arguments]

Commands:
  list
  create <name>
  set-model <name> codex|claude <model>
  login <name> codex|claude
EOF
}

valid_name() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

require_name() {
  valid_name "$1" || {
    echo "at=fatal msg=\"invalid profile name\" profile=$1" >&2
    return 1
  }
}

profile_names() {
  for path in "$SETTINGS_DIR"/codex_*; do
    [ -d "$path" ] || continue
    basename "$path" | sed 's/^codex_//'
  done
  for path in "$SETTINGS_DIR"/claude_*; do
    [ -d "$path" ] || continue
    basename "$path" | sed 's/^claude_//'
  done
  for path in "$SETTINGS_DIR"/.credentials.*.json; do
    [ -f "$path" ] || continue
    name=${path##*/.credentials.}
    printf '%s\n' "${name%.json}"
  done
}

list_profiles() {
  printf '%-20s %-12s %-24s %-12s %-24s\n' \
    PROFILE CODEX_AUTH CODEX_MODEL CLAUDE_AUTH CLAUDE_MODEL
  profile_names | sort -u | while IFS= read -r name; do
    codex_home="${SETTINGS_DIR}/codex_${name}"
    claude_home="${SETTINGS_DIR}/claude_${name}"
    codex_auth=no
    claude_auth=no
    [ -f "${codex_home}/auth.json" ] && codex_auth=yes
    [ -f "${SETTINGS_DIR}/.credentials.${name}.json" ] && claude_auth=yes
    codex_model=$(awk '
      /^[[:space:]]*\[/ { exit }
      /^[[:space:]]*model[[:space:]]*=/ {
        sub(/^[^=]*=[[:space:]]*/, "")
        gsub(/^"|"$/, "")
        print
        exit
      }
    ' "${codex_home}/default.config.toml" 2>/dev/null || true)
    claude_model=$(jq -r '.model // empty' \
      "${claude_home}/settings.json" 2>/dev/null || true)
    codex_model=${codex_model:-inherited}
    claude_model=${claude_model:-inherited}
    printf '%-20s %-12s %-24s %-12s %-24s\n' \
      "$name" "$codex_auth" "$codex_model" \
      "$claude_auth" "$claude_model"
  done
}

create_profile() {
  name=$1
  require_name "$name"

  umask 077
  codex_home="${SETTINGS_DIR}/codex_${name}"
  claude_home="${SETTINGS_DIR}/claude_${name}"
  mkdir -p "$codex_home" "$claude_home"
  [ -f "${codex_home}/default.config.toml" ] || \
    printf '%s\n' '# Codex profile defaults.' > \
      "${codex_home}/default.config.toml"
  [ -f "${claude_home}/settings.json" ] || \
    printf '%s\n' '{}' > "${claude_home}/settings.json"

  echo "at=info msg=\"profile created\" profile=$name"
}

set_model() {
  name=$1
  agent=$2
  model=$3
  require_name "$name"
  case "$model" in
    ''|*[!A-Za-z0-9._:/@-]*)
      echo "at=fatal msg=\"invalid model\" model=$model" >&2
      return 1
      ;;
  esac

  case "$agent" in
    codex)
      path="${SETTINGS_DIR}/codex_${name}/default.config.toml"
      mkdir -p "${path%/*}"
      [ -f "$path" ] || printf '%s\n' '# Codex profile defaults.' > "$path"
      ;;
    claude)
      path="${SETTINGS_DIR}/claude_${name}/settings.json"
      mkdir -p "${path%/*}"
      [ -f "$path" ] || printf '%s\n' '{}' > "$path"
      ;;
    *)
      echo "at=fatal msg=\"unknown profile agent\" agent=$agent" >&2
      return 1
      ;;
  esac

  tmp_dir=$(mktemp -d "${SETTINGS_DIR}/.profile-edit.XXXXXX")
  trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
  tmp_path="${tmp_dir}/$(basename "$path")"
  case "$agent" in
    codex)
      model_literal=$(jq -Rn --arg model "$model" '$model')
      MODEL_LITERAL="$model_literal" awk '
        BEGIN { print "model = " ENVIRON["MODEL_LITERAL"] }
        !in_table && /^[[:space:]]*\[/ { in_table = 1 }
        !in_table && /^[[:space:]]*model[[:space:]]*=/ { next }
        { print }
      ' "$path" > "$tmp_path"
      ;;
    claude)
      if ! jq --arg model "$model" '.model = $model' \
        "$path" > "$tmp_path"; then
        echo "at=fatal msg=\"invalid Claude settings JSON\" path=$path" >&2
        return 1
      fi
      ;;
  esac
  mv "$tmp_path" "$path"
  rmdir "$tmp_dir"
  trap - EXIT HUP INT TERM
  echo "at=info msg=\"profile model updated\" profile=$name agent=$agent model=$model"
}

login_profile() {
  name=$1
  agent=$2
  require_name "$name"

  case "$agent" in
    codex)
      exec "$SCRIPT_DIR/codex-login" "$name" --login
      ;;
    claude)
      CREDENTIALS_DIR="$SETTINGS_DIR" \
        exec "$SCRIPT_DIR/refresh-tokens" --login "$name"
      ;;
    *)
      echo "at=fatal msg=\"unknown profile agent\" agent=$agent" >&2
      return 1
      ;;
  esac
}

command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
  list)
    [ $# -eq 0 ] || { usage >&2; exit 1; }
    list_profiles
    ;;
  create)
    [ $# -eq 1 ] || { usage >&2; exit 1; }
    create_profile "$1"
    ;;
  set-model)
    [ $# -eq 3 ] || { usage >&2; exit 1; }
    set_model "$1" "$2" "$3"
    ;;
  login)
    [ $# -eq 2 ] || { usage >&2; exit 1; }
    login_profile "$1" "$2"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
