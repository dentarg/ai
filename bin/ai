#!/bin/sh

set -e
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(dirname "$SCRIPT_DIR")

AI_DIR=${AI_DIR:-"${HOME}/ai"}
BUNDLE_DIR=${AI_DIR}/bundle
COMMAND_HISTORY_DIR=${AI_DIR}/commandhistory
HISTORY_DIR=${AI_DIR}/history
REPOS_DIR=${AI_DIR}/repos
SETTINGS_DIR=${AI_DIR}/settings
SHARE_DIR=${AI_DIR}/share

PORT=${PORT:-1337}

fatal_unexpected_arg() {
  echo "at=fatal msg=\"unexpected argument\" arg=\"$1\"" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [profile | cx] [options]

Start the AI development container, optionally launching Claude Code with a
profile or Codex with "cx".

Options:
  -r, --resume <id>   Resume a prior Claude or Codex session
      --ports <list>  Publish comma-separated PORT or HOST:CONTAINER ports
      --remote        Enable Claude Code remote control
      --fast          Enable Claude Code fast mode
  -h, --help          Show this help

Environment:
  AI_DIR              Directory for persistent AI data (default: \$HOME/ai)
  AI_REMOTE           Enable remote control when set to 1, true, yes, or on
  AI_FAST             Enable fast mode when set to 1, true, yes, or on
  PORT                Primary published port (default: 1337)
EOF
}

is_true() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Parse arguments:
#   [profile]            optional claude profile; auto-launches `c <profile>`.
#   cx                   auto-launches `cx` once the container is up.
#   -r, --resume <id>    resume a prior session; passed on to `c --resume <id>`
#                        or `cx --resume <id>` when combined with `cx`.
#                        Claude works with or without a profile (`c` auto-detects it).
#   --ports <list>       extra ports to publish, comma-separated. Each entry is
#                        "PORT" (host==container) or "SRC:DST" (host:container).
#   --remote             enable Claude Code remote control; passed to `c --remote`.
#                        Also enabled when AI_REMOTE is truthy (1/true/yes/on).
#   --fast               enable fast mode; passed to `c --fast`.
#                        Also enabled when AI_FAST is truthy (1/true/yes/on).
#   -h, --help           show usage and exit.
PROFILE=""
RESUME=""
PORTS=""
CODEX_AUTO_START=""
REMOTE=${AI_REMOTE:-}
FAST=${AI_FAST:-}
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    cx)
      [ -z "$PROFILE" ] || fatal_unexpected_arg "$1"
      [ -z "$CODEX_AUTO_START" ] || fatal_unexpected_arg "$1"
      CODEX_AUTO_START=1
      ;;
    -r|--resume)
      shift
      [ $# -gt 0 ] || { echo "at=fatal msg=\"--resume requires a session id\"" >&2; exit 1; }
      RESUME=$1
      ;;
    --resume=*)
      RESUME=${1#--resume=}
      ;;
    --ports)
      shift
      [ $# -gt 0 ] || { echo "at=fatal msg=\"--ports requires an argument\"" >&2; exit 1; }
      PORTS=$1
      ;;
    --ports=*)
      PORTS=${1#--ports=}
      ;;
    --remote)
      REMOTE=1
      ;;
    --fast)
      FAST=1
      ;;
    -*)
      echo "at=fatal msg=\"unknown option\" option=\"$1\"" >&2
      exit 1
      ;;
    *)
      [ -z "$CODEX_AUTO_START" ] || fatal_unexpected_arg "$1"
      [ -z "$PROFILE" ] || fatal_unexpected_arg "$1"
      PROFILE=$1
      ;;
  esac
  shift
done

# Optional claude profile; when given, the container auto-launches `c <profile>`.
PROFILE_ENV=""
if [ -n "$PROFILE" ]; then
  CRED_FILE="${SETTINGS_DIR}/.credentials.${PROFILE}.json"
  if [ ! -f "$CRED_FILE" ]; then
    echo "at=fatal msg=\"claude profile not found\" profile=$PROFILE path=$CRED_FILE" >&2
    exit 1
  fi
  PROFILE_ENV="--env CLAUDE_PROFILE=$PROFILE"
fi

# Optional session to resume; passed through to the selected agent on launch.
RESUME_ENV=""
if [ -n "$RESUME" ]; then
  if [ -n "$CODEX_AUTO_START" ]; then
    RESUME_ENV="--env CODEX_RESUME=$RESUME"
  else
    RESUME_ENV="--env CLAUDE_RESUME=$RESUME"
  fi
fi

CODEX_ENV=""
[ -n "$CODEX_AUTO_START" ] && CODEX_ENV="--env CODEX_AUTO_START=1"

AGENT=""
if [ -n "$CODEX_AUTO_START" ]; then
  AGENT=codex
elif [ -n "$PROFILE" ] || [ -n "$RESUME" ]; then
  AGENT=claude
fi

# Opt-in remote control; `c` reads AI_REMOTE in the container and enables it.
REMOTE_ENV=""
is_true "$REMOTE" && REMOTE_ENV="--env AI_REMOTE=1"

# Opt-in fast mode; `c` reads AI_FAST in the container and enables it.
FAST_ENV=""
is_true "$FAST" && FAST_ENV="--env AI_FAST=1"

# Build extra "--publish SRC:DST" flags from --ports.
PUBLISH_PORTS=""
if [ -n "$PORTS" ]; then
  OLD_IFS=$IFS
  IFS=,
  for spec in $PORTS; do
    IFS=$OLD_IFS
    case "$spec" in
      *:*) src=${spec%%:*}; dst=${spec##*:} ;;
      *)   src=$spec; dst=$spec ;;
    esac
    case "$src" in ''|*[!0-9]*) echo "at=fatal msg=\"invalid port spec\" spec=$spec" >&2; exit 1 ;; esac
    case "$dst" in ''|*[!0-9]*) echo "at=fatal msg=\"invalid port spec\" spec=$spec" >&2; exit 1 ;; esac
    PUBLISH_PORTS="$PUBLISH_PORTS --publish ${src}:${dst}"
    IFS=,
  done
  IFS=$OLD_IFS
fi

CWD_LABEL=$(pwd)
case "$CWD_LABEL" in
  "$HOME") CWD_LABEL="~" ;;
  "$HOME"/*) CWD_LABEL="~/${CWD_LABEL#$HOME/}" ;;
esac

mkdir -p $BUNDLE_DIR
mkdir -p $COMMAND_HISTORY_DIR
mkdir -p $HISTORY_DIR
mkdir -p $REPOS_DIR
mkdir -p $SETTINGS_DIR/dotfiles
mkdir -p $SHARE_DIR

# Keep the shared OAuth token fresh on the host before launching, so every
# container session reuses it instead of re-authenticating. Silently refresh
# via the stored refresh token; only fall back to interactive login when that
# token is exhausted and the access token is still expired.
refresh_claude_token() {
  profile=$1
  cred_file="${SETTINGS_DIR}/.credentials.${profile}.json"

  command -v refresh-tokens >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  [ -f "$cred_file" ] || return 0

  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --once >/dev/null 2>&1 || true

  expires_at=$(jq -r '.claudeAiOauth.expiresAt // 0' "$cred_file" 2>/dev/null || echo 0)
  now_ms=$(( $(date +%s) * 1000 ))
  if [ "${expires_at:-0}" -gt "$now_ms" ]; then
    return 0
  fi

  if HISTORY_DIR="$HISTORY_DIR" \
    refresh-tokens --copy-active "$profile" "$cred_file" >/dev/null 2>&1; then
    echo "at=info msg=\"recovered active claude credentials from history\" profile=$profile" >&2
    return 0
  fi

  echo "at=info msg=\"claude token expired, logging in\" profile=$profile" >&2
  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --login "$profile"
}

[ -n "$PROFILE" ] && refresh_claude_token "$PROFILE"

# NET_ADMIN  tcpdump
# NET_RAW    ping
# SYS_PTRACE strace

podman run --rm --interactive --tty \
  --cap-add=NET_ADMIN \
  --cap-add=NET_RAW \
  --cap-add=SYS_PTRACE \
  --env HOST_DIR="$(basename "$(pwd)")" \
  --env PORT=${PORT} \
  ${PROFILE_ENV:-} \
  ${RESUME_ENV:-} \
  ${CODEX_ENV:-} \
  ${REMOTE_ENV:-} \
  ${FAST_ENV:-} \
  --volume ${BUNDLE_DIR}:/bundle \
  --volume ${COMMAND_HISTORY_DIR}:/commandhistory \
  --volume ${HISTORY_DIR}:/history \
  --volume ${REPOS_DIR}:/repos \
  --volume ${SETTINGS_DIR}:/settings \
  --volume ${SHARE_DIR}:/share \
  --volume ${REPO_DIR}/claude:/claude:ro \
  --volume $(pwd):/app \
  --workdir /app \
  --publish ${PORT} \
  ${PUBLISH_PORTS:-} \
  --label cwd="${CWD_LABEL}" \
  --label agent="${AGENT}" \
  ai:latest
