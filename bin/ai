#!/bin/sh

set -e
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(dirname "$SCRIPT_DIR")

AI_DIR=${AI_DIR:-"${HOME}/ai"}
BUNDLE_DIR=${AI_DIR}/bundle
COMMAND_HISTORY_DIR=${AI_DIR}/commandhistory
HISTORY_DIR=${AI_DIR}/history
REPOS_DIR=${AI_DIR}/repos
SETTINGS_DIR=${AI_DIR}/settings

PORT=${PORT:-1337}

# Optional claude profile; when given, the container auto-launches `c <profile>`.
PROFILE=${1:-}
PROFILE_ENV=""
if [ -n "$PROFILE" ]; then
  PROFILE_ENV="--env CLAUDE_PROFILE=$PROFILE"
fi

CWD_LABEL=$(pwd)
case "$CWD_LABEL" in
  "$HOME") CWD_LABEL="~" ;;
  "$HOME"/*) CWD_LABEL="~/${CWD_LABEL#$HOME/}" ;;
esac

mkdir -p $BUNDLE_DIR
mkdir -p $COMMAND_HISTORY_DIR
mkdir -p $HISTORY_DIR
mkdir -p $REPOS_DIR
mkdir -p $SETTINGS_DIR/dotfiles

# Keep the shared OAuth token fresh on the host before launching, so every
# container session reuses it instead of re-authenticating. Silently refresh
# via the stored refresh token; only fall back to interactive login when that
# token is exhausted and the access token is still expired.
refresh_claude_token() {
  profile=$1
  cred_file="${SETTINGS_DIR}/.credentials.${profile}.json"

  command -v refresh-tokens >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  [ -f "$cred_file" ] || return 0

  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --once >/dev/null 2>&1 || true

  expires_at=$(jq -r '.claudeAiOauth.expiresAt // 0' "$cred_file" 2>/dev/null || echo 0)
  now_ms=$(( $(date +%s) * 1000 ))
  if [ "${expires_at:-0}" -gt "$now_ms" ]; then
    return 0
  fi

  echo "at=info msg=\"claude token expired, logging in\" profile=$profile" >&2
  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --login "$profile"
}

[ -n "$PROFILE" ] && refresh_claude_token "$PROFILE"

# NET_ADMIN  tcpdump
# NET_RAW    ping
# SYS_PTRACE strace

podman run --rm --interactive --tty \
  --cap-add=NET_ADMIN \
  --cap-add=NET_RAW \
  --cap-add=SYS_PTRACE \
  --env HOST_DIR="$(basename "$(pwd)")" \
  --env PORT=${PORT} \
  ${PROFILE_ENV} \
  --volume ${BUNDLE_DIR}:/bundle \
  --volume ${COMMAND_HISTORY_DIR}:/commandhistory \
  --volume ${HISTORY_DIR}:/history \
  --volume ${REPOS_DIR}:/repos \
  --volume ${SETTINGS_DIR}:/settings \
  --volume ${REPO_DIR}/claude:/claude:ro \
  --volume $(pwd):/app \
  --workdir /app \
  --publish ${PORT} \
  --label cwd="${CWD_LABEL}" \
  ai:latest
