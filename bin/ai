#!/bin/sh

set -e
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(dirname "$SCRIPT_DIR")

AI_DIR=${AI_DIR:-"${HOME}/ai"}
BUNDLE_DIR=${AI_DIR}/bundle
COMMAND_HISTORY_DIR=${AI_DIR}/commandhistory
HISTORY_DIR=${AI_DIR}/history
REPOS_DIR=${AI_DIR}/repos
SETTINGS_DIR=${AI_DIR}/settings
SHARE_DIR=${AI_DIR}/share

PORT=${PORT:-1337}

fatal_unexpected_arg() {
  echo "at=fatal msg=\"unexpected argument\" arg=\"$1\"" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [profile | cx] [options]

Start the AI development environment, optionally launching Claude Code with a
profile or Codex with "cx". Podman is the default; --vm uses an ephemeral Lima VM.

Options:
  -r, --resume <id>   Resume a prior Claude or Codex session
      --ports <list>  Publish comma-separated PORT or HOST:CONTAINER ports
      --vm            Use an ephemeral Lima VM instead of a Podman container
      --keep-vm       Keep the Lima VM after exit (implies --vm)
      --gpu           Use the GPU-enabled Lima base VM
      --nested-virt   Enable nested virtualization in the Lima VM
      --cpus <count>  Override CPU count for the Lima VM
      --memory <GiB>  Override memory in GiB for the Lima VM
      --1password     Enable approved, allowlisted 1Password reads
      --remote        Enable Claude Code remote control
      --fast          Enable Claude Code fast mode
  -h, --help          Show this help

Environment:
  AI_DIR              Directory for persistent AI data (default: \$HOME/ai)
  AI_1PASSWORD        Enable the 1Password bridge when truthy
  AI_REMOTE           Enable remote control when set to 1, true, yes, or on
  AI_FAST             Enable fast mode when set to 1, true, yes, or on
  PORT                Primary published port (default: 1337)
  AI_VM_BASE          Lima base instance to clone (ai-base or ai-base-gpu)
  AI_VM_HOST_PORT     Primary host port (default: choose a free port)
EOF
}

is_true() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Parse arguments:
#   [profile]            optional claude profile; auto-launches `c <profile>`.
#   cx                   auto-launches `cx` once the container is up.
#   -r, --resume <id>    resume a prior session; passed on to `c --resume <id>`
#                        or `cx --resume <id>` when combined with `cx`.
#                        Claude works with or without a profile (`c` auto-detects it).
#   --ports <list>       extra ports to publish, comma-separated. Each entry is
#                        "PORT" (host==container) or "SRC:DST" (host:container).
#   --vm                 use an ephemeral Lima VM instead of Podman.
#   --keep-vm            retain the Lima VM after exit; implies --vm.
#   --gpu                use the GPU-enabled Lima base VM.
#   --nested-virt        expose KVM inside the Lima VM.
#   --cpus <count>       override the cloned Lima VM's CPU count.
#   --memory <GiB>       override the cloned Lima VM's memory.
#   --1password          start the approved, allowlisted 1Password bridge.
#   --remote             enable Claude Code remote control; passed to `c --remote`.
#                        Also enabled when AI_REMOTE is truthy (1/true/yes/on).
#   --fast               enable fast mode; passed to `c --fast`.
#                        Also enabled when AI_FAST is truthy (1/true/yes/on).
#   -h, --help           show usage and exit.
PROFILE=""
RESUME=""
PORTS=""
CODEX_AUTO_START=""
REMOTE=${AI_REMOTE:-}
FAST=${AI_FAST:-}
ONEPASSWORD=${AI_1PASSWORD:-}
VM_BACKEND=0
KEEP_VM=0
GPU=0
NESTED_VIRT=0
VM_CPUS=""
VM_MEMORY=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    cx)
      [ -z "$PROFILE" ] || fatal_unexpected_arg "$1"
      [ -z "$CODEX_AUTO_START" ] || fatal_unexpected_arg "$1"
      CODEX_AUTO_START=1
      ;;
    -r|--resume)
      shift
      [ $# -gt 0 ] || { echo "at=fatal msg=\"--resume requires a session id\"" >&2; exit 1; }
      RESUME=$1
      ;;
    --resume=*)
      RESUME=${1#--resume=}
      ;;
    --ports)
      shift
      [ $# -gt 0 ] || { echo "at=fatal msg=\"--ports requires an argument\"" >&2; exit 1; }
      PORTS=$1
      ;;
    --ports=*)
      PORTS=${1#--ports=}
      ;;
    --vm)
      VM_BACKEND=1
      ;;
    --keep-vm)
      VM_BACKEND=1
      KEEP_VM=1
      ;;
    --gpu)
      GPU=1
      ;;
    --nested-virt)
      NESTED_VIRT=1
      ;;
    --cpus)
      shift
      [ $# -gt 0 ] || { echo 'at=fatal msg="--cpus requires a count"' >&2; exit 1; }
      VM_CPUS=$1
      ;;
    --cpus=*)
      VM_CPUS=${1#--cpus=}
      [ -n "$VM_CPUS" ] || { echo 'at=fatal msg="--cpus requires a count"' >&2; exit 1; }
      ;;
    --memory)
      shift
      [ $# -gt 0 ] || { echo 'at=fatal msg="--memory requires GiB"' >&2; exit 1; }
      VM_MEMORY=$1
      ;;
    --memory=*)
      VM_MEMORY=${1#--memory=}
      [ -n "$VM_MEMORY" ] || { echo 'at=fatal msg="--memory requires GiB"' >&2; exit 1; }
      ;;
    --1password)
      ONEPASSWORD=1
      ;;
    --remote)
      REMOTE=1
      ;;
    --fast)
      FAST=1
      ;;
    -*)
      echo "at=fatal msg=\"unknown option\" option=\"$1\"" >&2
      exit 1
      ;;
    *)
      [ -z "$CODEX_AUTO_START" ] || fatal_unexpected_arg "$1"
      [ -z "$PROFILE" ] || fatal_unexpected_arg "$1"
      PROFILE=$1
      ;;
  esac
  shift
done

if [ "$GPU" -eq 1 ] || [ "$NESTED_VIRT" -eq 1 ] || \
  [ -n "$VM_CPUS" ] || [ -n "$VM_MEMORY" ]; then
  if [ "$VM_BACKEND" -ne 1 ]; then
    echo 'at=fatal msg="--gpu, --nested-virt, --cpus, and --memory require --vm"' >&2
    exit 1
  fi
fi
case "$VM_CPUS" in
  '') ;;
  0|*[!0-9]*)
    echo 'at=fatal msg="--cpus must be a positive integer"' >&2
    exit 1
    ;;
esac
case "$VM_MEMORY" in
  '') ;;
  0|*[!0-9]*)
    echo 'at=fatal msg="--memory must be a positive integer in GiB"' >&2
    exit 1
    ;;
esac

# Optional claude profile; when given, the container auto-launches `c <profile>`.
PROFILE_ENV=""
if [ -n "$PROFILE" ]; then
  CRED_FILE="${SETTINGS_DIR}/.credentials.${PROFILE}.json"
  if [ ! -f "$CRED_FILE" ]; then
    echo "at=fatal msg=\"claude profile not found\" profile=$PROFILE path=$CRED_FILE" >&2
    exit 1
  fi
  PROFILE_ENV="--env CLAUDE_PROFILE=$PROFILE"
fi

# Optional session to resume; passed through to the selected agent on launch.
RESUME_ENV=""
if [ -n "$RESUME" ]; then
  if [ -n "$CODEX_AUTO_START" ]; then
    RESUME_ENV="--env CODEX_RESUME=$RESUME"
  else
    RESUME_ENV="--env CLAUDE_RESUME=$RESUME"
  fi
fi

CODEX_ENV=""
[ -n "$CODEX_AUTO_START" ] && CODEX_ENV="--env CODEX_AUTO_START=1"

AGENT=""
if [ -n "$CODEX_AUTO_START" ]; then
  AGENT=codex
elif [ -n "$PROFILE" ] || [ -n "$RESUME" ]; then
  AGENT=claude
fi

# Opt-in remote control; `c` reads AI_REMOTE in the container and enables it.
REMOTE_ENV=""
is_true "$REMOTE" && REMOTE_ENV="--env AI_REMOTE=1"

# Opt-in fast mode; `c` reads AI_FAST in the container and enables it.
FAST_ENV=""
is_true "$FAST" && FAST_ENV="--env AI_FAST=1"

# Build extra "--publish SRC:DST" flags from --ports.
PUBLISH_PORTS=""
if [ -n "$PORTS" ]; then
  OLD_IFS=$IFS
  IFS=,
  for spec in $PORTS; do
    IFS=$OLD_IFS
    case "$spec" in
      *:*) src=${spec%%:*}; dst=${spec##*:} ;;
      *)   src=$spec; dst=$spec ;;
    esac
    case "$src" in ''|*[!0-9]*) echo "at=fatal msg=\"invalid port spec\" spec=$spec" >&2; exit 1 ;; esac
    case "$dst" in ''|*[!0-9]*) echo "at=fatal msg=\"invalid port spec\" spec=$spec" >&2; exit 1 ;; esac
    PUBLISH_PORTS="$PUBLISH_PORTS --publish ${src}:${dst}"
    IFS=,
  done
  IFS=$OLD_IFS
fi

CWD_LABEL=$(pwd)
case "$CWD_LABEL" in
  "$HOME") CWD_LABEL="~" ;;
  "$HOME"/*) CWD_LABEL="~/${CWD_LABEL#$HOME/}" ;;
esac

mkdir -p $BUNDLE_DIR
mkdir -p $COMMAND_HISTORY_DIR
mkdir -p $HISTORY_DIR
mkdir -p $REPOS_DIR
mkdir -p $SETTINGS_DIR/dotfiles
mkdir -p $SHARE_DIR

BROKER_PID=""
BROKER_SESSION_DIR=""
ONEPASSWORD_ENV=""
ONEPASSWORD_VOLUME=""
VM_NAME=""

cleanup_onepassword_bridge() {
  if [ -n "$BROKER_PID" ]; then
    kill "$BROKER_PID" 2>/dev/null || true
    wait "$BROKER_PID" 2>/dev/null || true
  fi
  if [ -n "$BROKER_SESSION_DIR" ] && [ -d "$BROKER_SESSION_DIR" ]; then
    rm -rf "$BROKER_SESSION_DIR"
  fi
}

cleanup_vm() {
  [ -n "$VM_NAME" ] || return 0
  if [ "$KEEP_VM" -eq 1 ]; then
    echo "at=info msg=\"keeping Lima VM\" vm=$VM_NAME" >&2
    return 0
  fi
  limactl stop "$VM_NAME" >/dev/null 2>&1 || true
  limactl delete --force "$VM_NAME" >/dev/null 2>&1 || true
}

cleanup() {
  cleanup_vm
  cleanup_onepassword_bridge
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

start_onepassword_bridge() {
  if [ "$(uname -s)" != "Darwin" ]; then
    echo 'at=fatal msg="the 1Password bridge requires a macOS host"' >&2
    exit 1
  fi

  policy_path="${AI_DIR}/1password-bridge.json"
  if [ ! -f "$policy_path" ]; then
    echo "at=fatal msg=\"1Password bridge policy not found\" path=\"$policy_path\"" >&2
    exit 1
  fi

  for command_name in op osascript ruby; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      echo "at=fatal msg=\"required command not found\" command=$command_name" >&2
      exit 1
    fi
  done

  run_dir="${AI_DIR}/run"
  log_dir="${AI_DIR}/logs"
  mkdir -p "$run_dir" "$log_dir"
  chmod 700 "$run_dir" "$log_dir"
  BROKER_SESSION_DIR=$(mktemp -d "${run_dir}/onepassword.XXXXXX")
  chmod 700 "$BROKER_SESSION_DIR"

  OP_BRIDGE_TOKEN=$(ruby -rsecurerandom -e 'print SecureRandom.hex(32)')
  OP_BRIDGE_PROJECT=$(pwd -P)
  OP_BRIDGE_POLICY=$policy_path
  OP_BRIDGE_OP_BIN=$(command -v op)
  OP_BRIDGE_CA_FILE="${BROKER_SESSION_DIR}/ca.pem"
  OP_BRIDGE_PORT_FILE="${BROKER_SESSION_DIR}/port"
  export OP_BRIDGE_TOKEN OP_BRIDGE_PROJECT OP_BRIDGE_POLICY OP_BRIDGE_OP_BIN
  export OP_BRIDGE_CA_FILE OP_BRIDGE_PORT_FILE

  broker_log="${log_dir}/1password-bridge.log"
  ruby "${REPO_DIR}/tools/onepassword-bridge/server.rb" >> "$broker_log" 2>&1 &
  BROKER_PID=$!
  attempts=0
  while [ ! -s "$OP_BRIDGE_PORT_FILE" ]; do
    if ! kill -0 "$BROKER_PID" 2>/dev/null; then
      echo "at=fatal msg=\"1Password bridge failed to start\" log=\"$broker_log\"" >&2
      tail -20 "$broker_log" >&2
      exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 100 ]; then
      echo "at=fatal msg=\"timed out starting 1Password bridge\" log=\"$broker_log\"" >&2
      exit 1
    fi
    sleep 0.05
  done

  bridge_port=$(cat "$OP_BRIDGE_PORT_FILE")
  case "$bridge_port" in
    ''|*[!0-9]*)
      echo 'at=fatal msg="1Password bridge returned an invalid port"' >&2
      exit 1
      ;;
  esac

  if [ "$VM_BACKEND" -eq 1 ]; then
    OP_BRIDGE_URL="https://host.lima.internal:${bridge_port}"
  else
    OP_BRIDGE_URL="https://host.containers.internal:${bridge_port}"
  fi
  OP_BRIDGE_CA=/run/1password-bridge/ca.pem
  export OP_BRIDGE_URL OP_BRIDGE_CA
  ONEPASSWORD_ENV="--env OP_BRIDGE_URL --env OP_BRIDGE_TOKEN --env OP_BRIDGE_CA"
  ONEPASSWORD_VOLUME="--volume ${BROKER_SESSION_DIR}:/run/1password-bridge:ro"
  echo "at=info msg=\"1Password bridge ready\" project=\"$OP_BRIDGE_PROJECT\"" >&2
}

is_true "$ONEPASSWORD" && start_onepassword_bridge

# Keep the shared OAuth token fresh on the host before launching, so every
# container session reuses it instead of re-authenticating. Silently refresh
# via the stored refresh token; only fall back to interactive login when that
# token is exhausted and the access token is still expired.
refresh_claude_token() {
  profile=$1
  cred_file="${SETTINGS_DIR}/.credentials.${profile}.json"

  command -v refresh-tokens >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  [ -f "$cred_file" ] || return 0

  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --once >/dev/null 2>&1 || true

  expires_at=$(jq -r '.claudeAiOauth.expiresAt // 0' "$cred_file" 2>/dev/null || echo 0)
  now_ms=$(( $(date +%s) * 1000 ))
  if [ "${expires_at:-0}" -gt "$now_ms" ]; then
    return 0
  fi

  if HISTORY_DIR="$HISTORY_DIR" \
    refresh-tokens --copy-active "$profile" "$cred_file" >/dev/null 2>&1; then
    echo "at=info msg=\"recovered active claude credentials from history\" profile=$profile" >&2
    return 0
  fi

  echo "at=info msg=\"claude token expired, logging in\" profile=$profile" >&2
  CREDENTIALS_DIR="$SETTINGS_DIR" refresh-tokens --login "$profile"
}

[ -n "$PROFILE" ] && refresh_claude_token "$PROFILE"

free_host_port() {
  if [ -n "${AI_VM_HOST_PORT:-}" ]; then
    case "$AI_VM_HOST_PORT" in
      ''|*[!0-9]*) echo 'at=fatal msg="AI_VM_HOST_PORT must be numeric"' >&2; exit 1 ;;
    esac
    printf '%s\n' "$AI_VM_HOST_PORT"
  elif command -v ruby >/dev/null 2>&1; then
    ruby -rsocket -e 's = TCPServer.new("127.0.0.1", 0); print s.addr[1]; s.close'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'
  else
    echo 'at=fatal msg="ruby or python3 is required to allocate a Lima host port"' >&2
    exit 1
  fi
}

next_vm_name() {
  project_name=$(basename "$(pwd -P)" | tr '[:upper:]' '[:lower:]')
  project_name=$(printf '%s' "$project_name" | sed \
    -e 's/[^a-z0-9-]/-/g' \
    -e 's/--*/-/g' \
    -e 's/^-//' \
    -e 's/-$//' | cut -c1-57)
  project_name=${project_name%-}
  [ -n "$project_name" ] || project_name=workspace

  existing_names=$(limactl list --format '{{.Name}}' 2>/dev/null)
  index=0
  while [ "$index" -lt 100 ]; do
    candidate=$(printf 'ai-%02d-%s' "$index" "$project_name")
    if ! printf '%s\n' "$existing_names" | grep -Fx "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
    index=$((index + 1))
  done

  echo "at=fatal msg=\"no available Lima VM name\" project=$project_name" >&2
  return 1
}

run_lima_vm() {
  command -v limactl >/dev/null 2>&1 || {
    echo 'at=fatal msg="limactl is required for --vm; install Lima first"' >&2
    exit 1
  }
  command -v jq >/dev/null 2>&1 || {
    echo 'at=fatal msg="jq is required for --vm"' >&2
    exit 1
  }
  case "$PORT" in
    ''|*[!0-9]*) echo 'at=fatal msg="PORT must be numeric for --vm"' >&2; exit 1 ;;
  esac

  if [ "$GPU" -eq 1 ]; then
    base_name=${AI_VM_BASE:-ai-base-gpu}
  else
    base_name=${AI_VM_BASE:-ai-base}
  fi
  if ! limactl list --format '{{.Name}}' | grep -Fx "$base_name" >/dev/null 2>&1; then
    echo "at=fatal msg=\"Lima base VM not found; run ./build_vm first\" vm=$base_name" >&2
    exit 1
  fi

  VM_NAME=$(next_vm_name)
  primary_host_port=$(free_host_port)

  mounts_json=$(jq -cn \
    --arg bundle "$BUNDLE_DIR" \
    --arg commands "$COMMAND_HISTORY_DIR" \
    --arg history "$HISTORY_DIR" \
    --arg repos "$REPOS_DIR" \
    --arg settings "$SETTINGS_DIR" \
    --arg share "$SHARE_DIR" \
    --arg claude "${REPO_DIR}/claude" \
    --arg app "$(pwd -P)" \
    '[
      {location:$bundle, mountPoint:"/bundle", writable:true},
      {location:$commands, mountPoint:"/commandhistory", writable:true},
      {location:$history, mountPoint:"/history", writable:true},
      {location:$repos, mountPoint:"/repos", writable:true},
      {location:$settings, mountPoint:"/settings", writable:true},
      {location:$share, mountPoint:"/share", writable:true},
      {location:$claude, mountPoint:"/claude", writable:false},
      {location:$app, mountPoint:"/app", writable:true}
    ]')

  if [ -n "$BROKER_SESSION_DIR" ]; then
    mounts_json=$(printf '%s' "$mounts_json" | jq -c \
      --arg location "$BROKER_SESSION_DIR" \
      '. + [{location:$location, mountPoint:"/run/1password-bridge", writable:false}]')
  fi

  forwards_json=$(jq -cn \
    --argjson guest "$PORT" \
    --argjson host "$primary_host_port" \
    '[{guestPort:$guest, hostPort:$host, guestIP:"127.0.0.1", hostIP:"127.0.0.1", static:true}]')

  if [ -n "$PORTS" ]; then
    OLD_IFS=$IFS
    IFS=,
    for spec in $PORTS; do
      IFS=$OLD_IFS
      case "$spec" in
        *:*) src=${spec%%:*}; dst=${spec##*:} ;;
        *) src=$spec; dst=$spec ;;
      esac
      forwards_json=$(printf '%s' "$forwards_json" | jq -c \
        --argjson src "$src" --argjson dst "$dst" \
        '. + [{guestPort:$dst, hostPort:$src, guestIP:"127.0.0.1", hostIP:"127.0.0.1", static:true}]')
      IFS=,
    done
    IFS=$OLD_IFS
  fi

  config_expression=".mounts = ${mounts_json} | .portForwards = ${forwards_json} | .timezone = \"UTC\""
  set -- clone --tty=false
  [ "$NESTED_VIRT" -eq 1 ] && set -- "$@" --nested-virt
  [ -n "$VM_CPUS" ] && set -- "$@" --cpus "$VM_CPUS"
  [ -n "$VM_MEMORY" ] && set -- "$@" --memory "$VM_MEMORY"
  set -- "$@" --set "$config_expression" "$base_name" "$VM_NAME"
  limactl "$@"
  limactl start "$VM_NAME"
  limactl shell --workdir /app "$VM_NAME" sudo hostnamectl set-hostname "$VM_NAME"

  if [ -n "$BROKER_SESSION_DIR" ]; then
    # Keep the token out of process arguments and Lima configuration/logs.
    printf '%s' "$OP_BRIDGE_TOKEN" | \
      limactl shell --workdir /app "$VM_NAME" sh -c 'umask 077; cat > /workspace/.ai-op-token'
  fi

  echo "at=info msg=\"Lima VM ready\" vm=$VM_NAME port=$primary_host_port guest_port=$PORT" >&2

  set -- env \
    HOME=/workspace \
    BASH_ENV=/workspace/.bash_profile \
    HOST_DIR="$(basename "$(pwd)")" \
    PORT="$PORT" \
    AI_AUTO_LAUNCH=1
  [ -n "$PROFILE" ] && set -- "$@" CLAUDE_PROFILE="$PROFILE"
  if [ -n "$RESUME" ]; then
    if [ -n "$CODEX_AUTO_START" ]; then
      set -- "$@" CODEX_RESUME="$RESUME"
    else
      set -- "$@" CLAUDE_RESUME="$RESUME"
    fi
  fi
  [ -n "$CODEX_AUTO_START" ] && set -- "$@" CODEX_AUTO_START=1
  is_true "$REMOTE" && set -- "$@" AI_REMOTE=1
  is_true "$FAST" && set -- "$@" AI_FAST=1
  if [ -n "$BROKER_SESSION_DIR" ]; then
    set -- "$@" \
      OP_BRIDGE_URL="$OP_BRIDGE_URL" \
      OP_BRIDGE_CA=/run/1password-bridge/ca.pem \
      OP_BRIDGE_TOKEN_FILE=/workspace/.ai-op-token
  fi
  set -- "$@" bash -c '
    if [ ! -s /workspace/.bashrc ] || [ ! -s /usr/local/bin/cx ] || \
      [ ! -s /usr/local/bin/x ] || \
      ! grep -F "alias x=exit" /workspace/.bashrc >/dev/null; then
      echo "at=fatal msg=\"Lima clone is missing the provisioned shell or tools\"" >&2
      exit 1
    fi
    if [ -n "${OP_BRIDGE_TOKEN_FILE:-}" ]; then
      export OP_BRIDGE_TOKEN=$(cat "$OP_BRIDGE_TOKEN_FILE")
    fi
    cd /app
    exec bash --rcfile /workspace/.bashrc -i
  '
  session_status=0
  limactl shell --workdir /app "$VM_NAME" "$@" || session_status=$?
  if [ -n "$BROKER_SESSION_DIR" ]; then
    limactl shell --workdir /app "$VM_NAME" sh -c 'rm -f /workspace/.ai-op-token' >/dev/null 2>&1 || true
  fi
  return "$session_status"
}

if [ "$VM_BACKEND" -eq 1 ]; then
  run_lima_vm
  exit $?
fi

# NET_ADMIN  tcpdump
# NET_RAW    ping
# SYS_PTRACE strace

podman run --rm --interactive --tty \
  --cap-add=NET_ADMIN \
  --cap-add=NET_RAW \
  --cap-add=SYS_PTRACE \
  --env HOST_DIR="$(basename "$(pwd)")" \
  --env PORT=${PORT} \
  ${PROFILE_ENV:-} \
  ${RESUME_ENV:-} \
  ${CODEX_ENV:-} \
  ${REMOTE_ENV:-} \
  ${FAST_ENV:-} \
  ${ONEPASSWORD_ENV:-} \
  --volume ${BUNDLE_DIR}:/bundle \
  --volume ${COMMAND_HISTORY_DIR}:/commandhistory \
  --volume ${HISTORY_DIR}:/history \
  --volume ${REPOS_DIR}:/repos \
  --volume ${SETTINGS_DIR}:/settings \
  --volume ${SHARE_DIR}:/share \
  ${ONEPASSWORD_VOLUME:-} \
  --volume ${REPO_DIR}/claude:/claude:ro \
  --volume $(pwd):/app \
  --workdir /app \
  --publish ${PORT} \
  ${PUBLISH_PORTS:-} \
  --label cwd="${CWD_LABEL}" \
  --label agent="${AGENT}" \
  ai:latest
